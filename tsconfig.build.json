{
  "exclude": ["./*.config.ts", "./data/*", "*/*.stories.tsx"],
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["src/*", "src/*/index"]
    }
  }
}
