{
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["*", "*/index"]
    }
  },
  "exclude": ["**/*.stories.tsx"],
  "include": ["**/*.ts", "**/*.tsx"]
}
